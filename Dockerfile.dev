# 使用修复后的本地Ubuntu 22.04镜像
FROM ubuntu:22.04-fixed

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV COLCON_WS=/root/colcon_ws
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# 第一步：修复系统依赖问题
RUN apt-get update && apt-get install -y --reinstall \
    systemd systemd-sysv \
    libapt-pkg6.0 \
    libsystemd0 \
    libudev1 \
    util-linux \
    bsdutils \
    && apt-get install -y software-properties-common \
    && add-apt-repository universe \
    && add-apt-repository multiverse \
    && apt-get update

# 第二步：安装基础工具
RUN apt-get install -y \
    curl wget gnupg lsb-release ca-certificates \
    git vim nano \
    build-essential cmake gcc g++ \
    python3 python3-dev python3-pip \
    locales \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# 添加ROS2 Humble源
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null

# 添加Gazebo官方源
RUN wget https://packages.osrfoundation.org/gazebo.gpg -O /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/gazebo-stable.list > /dev/null

# 安装ROS2 Humble和Gazebo集成
RUN apt-get update && apt-get install -y \
    ros-humble-ros-core \
    ros-humble-ros-gz \
    python3-colcon-common-extensions \
    python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# 安装Gazebo Fortress (新版Gazebo，适配ROS2)
RUN apt-get update && apt-get install -y \
    gz-fortress \
    && rm -rf /var/lib/apt/lists/*

# 安装开发库
RUN apt-get update && apt-get install -y \
    libeigen3-dev \
    libarmadillo-dev \
    libgsl-dev \
    libpcl-dev pcl-tools \
    libx11-dev x11-utils xauth \
    libglfw3-dev libglm-dev \
    && rm -rf /var/lib/apt/lists/*

# 安装Python依赖
RUN pip3 install --no-cache-dir \
    numpy scipy opencv-python \
    pyyaml \
    fastapi uvicorn pydantic \
    python-multipart

# 安装NLopt
RUN git clone -b v2.7.1 https://github.com/stevengj/nlopt.git /tmp/nlopt && \
    cd /tmp/nlopt && mkdir build && cd build && \
    cmake .. && make -j4 && make install && \
    ldconfig && \
    rm -rf /tmp/nlopt

# 初始化rosdep（可能因网络问题失败，可以后续手动初始化）
RUN rosdep init || true
RUN rosdep update || true

# 创建工作目录
RUN mkdir -p $COLCON_WS/src
WORKDIR $COLCON_WS

# 配置环境变量
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc && \
    echo "source $COLCON_WS/install/setup.bash 2>/dev/null || true" >> ~/.bashrc && \
    echo "export GAZEBO_PLUGIN_PATH=$COLCON_WS/install/lib:\$GAZEBO_PLUGIN_PATH" >> ~/.bashrc && \
    echo "export GAZEBO_MODEL_PATH=$COLCON_WS/src:\$GAZEBO_MODEL_PATH" >> ~/.bashrc && \
    echo "export LD_LIBRARY_PATH=$COLCON_WS/install/lib:\$LD_LIBRARY_PATH" >> ~/.bashrc && \
    echo "export ROS_DOMAIN_ID=0" >> ~/.bashrc

# 暴露端口
EXPOSE 1919 8000 11311

# 入口点
CMD ["/bin/bash"]
